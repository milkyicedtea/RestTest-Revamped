# Copy to .env on each server and adjust. Compose reads it automatically.

# Which services this server hosts (compose profiles, space-separated):
#   db       - postgres + dragonfly (run on ONE server only)
#   api-hono - hono benchmark API
COMPOSE_PROFILES=api-hono,db

# --- Test database (only meaningful on the db server) ---
POSTGRES_PASSWORD=password
POSTGRES_DB=benchmark
# Host port the test postgres is published on. Frameworks on OTHER servers
# point DATABASE_URL at <this server's address>:<POSTGRES_HOST_PORT>.
POSTGRES_HOST_PORT=5433
DRAGONFLY_HOST_PORT=6380

# --- Framework APIs ---
# Where the API finds the test database. Same-server default uses the compose
# network hostname; cross-server deployments must point it at the db server's
# address instead.
DATABASE_URL=postgres://postgres:password@postgres:5432/benchmark
HONO_PORT=4101
HONO_HOST_PORT=4101
